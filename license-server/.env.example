# Senha do painel /admin (Basic Auth; usuário fixo: admin)
LICENSE_ADMIN_PASSWORD=troque-esta-senha

# Segredo HMAC para assinar respostas do /v1/license/check
# Deve ser o MESMO valor embutido no app (LICENSE_VERIFY_KEY em apac_bot.license)
LICENSE_SIGNING_SECRET=troque-este-segredo-hmac-compartilhado

# URL pública exibida no admin (a clínica coloca em licenca.server_url no config.json)
LICENSE_PUBLIC_URL=http://127.0.0.1:8090

# Opcional: caminho do SQLite (padrão: data/licenses.db relativo a este diretório)
# LICENSE_DB_PATH=data/licenses.db
